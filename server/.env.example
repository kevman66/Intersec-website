# Copy this file to .env on the server and fill in real values.
# Never commit the real .env file.

# The Gmail account that will send the email (can be intersecug@gmail.com itself,
# or a separate Gmail account if you'd rather not put an app password on the main inbox)
GMAIL_USER=intersecug@gmail.com

# Generate at https://myaccount.google.com/apppasswords (requires 2-Step Verification enabled)
GMAIL_APP_PASSWORD=

# Where submissions get delivered — defaults to GMAIL_USER if not set
TO_EMAIL=intersecug@gmail.com

# Port the API listens on internally (Nginx will proxy to this)
PORT=3001
