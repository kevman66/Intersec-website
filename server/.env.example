# Copy this file to .env on the server and fill in real values.
# Never commit the real .env file.

# Brevo SMTP credentials — find these in Brevo under
# Settings → SMTP & API → SMTP tab. BREVO_SMTP_USER is your Brevo login
# email; BREVO_SMTP_KEY is the generated SMTP key (not your account password).
BREVO_SMTP_USER=
BREVO_SMTP_KEY=

# The "from" address on outgoing mail — must be a sender verified in Brevo
# (single sender verification, or domain authentication for intersecug.com)
FROM_EMAIL=forms@intersecug.com

# Where submissions get delivered. info@intersecug.com forwards to Gmail
# via Cloudflare Email Routing, so this can just stay as-is.
TO_EMAIL=info@intersecug.com

# Port the API listens on internally (Nginx will proxy to this)
PORT=3001
